# Rustrade Configuration Template
# Usage: cp .env.example .env

# --- MODE ---
# mock: Simulation mode with fake data and orders
# alpaca: Live or Paper trading via Alpaca
# oanda: Live or Practice trading via OANDA
# binance: Live or Testnet trading via Binance Spot
MODE=mock

# --- LIVE TRADING SAFETY GATE ---
# ⚠️  REQUIRED whenever the broker URL is not a sandbox, for every broker:
#   - Alpaca:  ALPACA_BASE_URL without "paper-api"
#   - Binance: BINANCE_BASE_URL without "testnet"
#   - OANDA:   OANDA_API_BASE_URL without "fxpractice"
# Unknown URLs (proxies, custom endpoints) are treated as production.
# Without this flag set to "true", the application will refuse to start in live mode.
# This prevents accidental trading with real money.
# TRADING_LIVE=false

# --- ASSET CLASS ---
# Stock: Standard stock market hours (restarts daily)
# Crypto: 24/7 market (resets at 00:00 UTC)
ASSET_CLASS=Stock

# --- ALPACA CREDENTIALS (Required if MODE=alpaca) ---
ALPACA_API_KEY=YOUR_API_KEY_HERE
ALPACA_SECRET_KEY=YOUR_SECRET_KEY_HERE

# --- NEWS FEED (Optional) ---
# If set, uses RSS feed for news. Otherwise uses MockNewsService for testing.
# Example: NEWS_RSS_URL=https://cryptopanic.com/news/rss/
# NEWS_RSS_URL=

ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_URL=https://data.alpaca.markets
ALPACA_WS_URL=wss://stream.data.alpaca.markets/v2/iex

# --- OANDA CREDENTIALS (Required if MODE=oanda) ---
OANDA_API_KEY=YOUR_OANDA_KEY_HERE
OANDA_ACCOUNT_ID=YOUR_ACCOUNT_ID_HERE
OANDA_API_BASE_URL=https://api-fxpractice.oanda.com
OANDA_STREAM_BASE_URL=https://stream-fxpractice.oanda.com

# --- BINANCE CREDENTIALS (Required if MODE=binance) ---
# Defaults to the Spot testnet. Production: https://api.binance.com and
# wss://stream.binance.com:9443 (requires TRADING_LIVE=true).
BINANCE_API_KEY=YOUR_BINANCE_KEY_HERE
BINANCE_SECRET_KEY=YOUR_BINANCE_SECRET_HERE
BINANCE_BASE_URL=https://testnet.binance.vision
BINANCE_WS_URL=wss://stream.testnet.binance.vision

# --- TRADING PARAMETERS ---
SYMBOLS=AAPL,NVDA,SPY

# CRYPTO TOP 10 (Uncomment to use with ASSET_CLASS=Crypto)
# SYMBOLS=BTC/USD,ETH/USD,SOL/USD,BNB/USD,XRP/USD,ADA/USD,AVAX/USD,LINK/USD,DOT/USD,MATIC/USD
MAX_POSITIONS=5
INITIAL_CASH=100000.0

# --- STRATEGY ---
# standard: Simple Dual SMA crossover
# advanced: Triple Filter (SMA + RSI + MACD)
# dynamic: Market Scanner based
STRATEGY_MODE=advanced

# --- RISK MANAGEMENT ---
# Score from 1 (Conservative) to 9 (Aggressive)
# This overrides individual risk parameters if set.
RISK_APPETITE_SCORE=8

# --- SYSTEM ---
LOG_LEVEL=info
PORTFOLIO_REFRESH_INTERVAL_MS=2000
DYNAMIC_SYMBOL_MODE=false

# --- MULTI-TIMEFRAME CONFIGURATION ---
# Format: 1Min, 5Min, 15Min, 1Hour, 4Hour, 1Day

# DAY TRADING (Default)
PRIMARY_TIMEFRAME=15Min
TIMEFRAMES=1Min,5Min,15Min,1Hour
TREND_TIMEFRAME=1Hour
TREND_SMA_PERIOD=50

# SWING TRADING (Uncomment to use)
# PRIMARY_TIMEFRAME=1Hour
# TIMEFRAMES=15Min,1Hour,4Hour,1Day
# TREND_TIMEFRAME=1Day
# TREND_SMA_PERIOD=50

# CRYPTO 24/7 (Uncomment to use)
# PRIMARY_TIMEFRAME=15Min
# TIMEFRAMES=5Min,15Min,1Hour,4Hour,1Day
# TREND_TIMEFRAME=4Hour
# TREND_SMA_PERIOD=50

# SCALPING (Uncomment to use)
# PRIMARY_TIMEFRAME=1Min
# TIMEFRAMES=1Min,5Min
# TREND_TIMEFRAME=5Min
# TREND_SMA_PERIOD=20

# --- ML CONFIGURATION ---
ENABLE_ML_DATA_COLLECTION=true

# --- OBSERVABILITY & ALERTING ---
OBSERVABILITY_ENABLED=true
# NOTE: no Prometheus HTTP endpoint is served yet; metrics are pushed as METRICS_JSON to stdout.
# PORT/BIND_ADDRESS below are reserved for that future endpoint and currently unused.
OBSERVABILITY_PORT=9090
OBSERVABILITY_BIND_ADDRESS=127.0.0.1
# Optional: Webhook URL to send structured alert events (e.g. Discord, Slack, custom webhook) when the circuit breaker triggers
# ALERT_WEBHOOK_URL=https://discord.com/api/webhooks/...

# --- SERVER API (server binary only) ---
# REST/WebSocket API exposing the portfolio and the live log stream.
# Binding to a non-loopback address (e.g. 0.0.0.0 in Docker) REQUIRES API_KEY,
# otherwise the server refuses to start. Clients send it in the X-API-Key header.
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
# API_KEY=generate-a-random-key-of-at-least-16-chars
